# LinkPlease nik — Environment Configuration

# Your API key from pseudogram-api.onrender.com
API_KEY=your_api_key_here

# The mock API base URL
MOCK_API_BASE_URL=https://pseudogram-api.onrender.com

# SQLite database path
DATABASE_PATH=./nik.db

# Host/port for running the app locally
HOST=0.0.0.0
PORT=8000

# Max retries for failed DMs
MAX_RETRIES=5

# Seconds between reconciler polls
RECONCILER_INTERVAL_SECONDS=10
